  lines:
  - text: "WHAT THE H\u2014"
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 6
    particlePrefab: {fileID: 0}
  - text: "Oh\u2026 how intriguing."
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 0
    particlePrefab: {fileID: 0}
  - text: "Oh\u2026 how intriguing."
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 0
    particlePrefab: {fileID: 0}
  - text: It appears fortune has chosen to grace you with a fleeting touch.
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 4
    particlePrefab: {fileID: 0}
  - text: Do not get used to it.
