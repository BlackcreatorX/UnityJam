%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f235e9a96eb7bbb419458f22113d08f2, type: 3}
  m_Name: 1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueSequence
  lines:
  - text: Now, for something a little more interesting.
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 3
    particlePrefab: {fileID: 0}
  - text: "Luck is charming, but intuition\u2026 Ah, intuition is an art that few
      master."
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 2
    particlePrefab: {fileID: 0}
  - text: 'The rules are simple: you will have a limited number of turns to guess
      your opponent''s number.'
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 5
    particlePrefab: {fileID: 0}
  - text: "But if you reach the end without guessing right\u2026"
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 3
    particlePrefab: {fileID: 0}
  - text: You'll have to pull the trigger. A little game of Russian roulette to add
      some excitement to your pitiful attempts.
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 5
    particlePrefab: {fileID: 0}
  - text: "Isn't it delightful? Every guess brings you just a little bit closer to
      the answer\u2026 or to your doom."
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 2
    particlePrefab: {fileID: 0}
  - text: Come on! Show me if your intuition is worth anything more than your soul.
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 1
    particlePrefab: {fileID: 0}
