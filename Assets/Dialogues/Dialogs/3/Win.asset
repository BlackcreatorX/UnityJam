  m_Script: {fileID: 11500000, guid: f235e9a96eb7bbb419458f22113d08f2, type: 3}
  m_Name: Win
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueSequence
  lines:
  - text: What?
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 7
    particlePrefab: {fileID: 0}
  - text: How did you guess correctly?!
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 6
    particlePrefab: {fileID: 0}
  - text: "No, no, no! This is absurd! My number was perfectly unpredictable!"
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 7
    particlePrefab: {fileID: 0}
  - text: "I am Mammon, by every circle of Hell! I won't let an insignificant soul humiliate me like this!"
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 4
    particlePrefab: {fileID: 0}
