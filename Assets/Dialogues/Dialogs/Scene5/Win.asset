%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f235e9a96eb7bbb419458f22113d08f2, type: 3}
  m_Name: Win
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueSequence
  lines:
  - text: No.
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 7
    particlePrefab: {fileID: 0}
  - text: "No, no, no\u2026 This can't be happening!"
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 6
    particlePrefab: {fileID: 0}
  - text: How dare you?! Do you even have any idea who you're playing with?!
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 4
    particlePrefab: {fileID: 0}
  - text: "I\u2026 I am Mammon. The Sovereign of Greed! I cannot lose to an insignificant
      soul like you!"
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 0
    particlePrefab: {fileID: 0}
  - text: Wait! We can renegotiate the deal! I can offer you riches, power, anything
      you desire!
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 6
    particlePrefab: {fileID: 0}
  - text: "\u2026Damn it."
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 7
    particlePrefab: {fileID: 0}
  - text: Don't think this is over, mortal.
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 4
    particlePrefab: {fileID: 0}
