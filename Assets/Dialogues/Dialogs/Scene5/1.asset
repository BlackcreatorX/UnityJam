  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueSequence
  lines:
  - text: And now, our final game
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 3
    particlePrefab: {fileID: 0}
  - text: Five cards. Five possibilities.
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 2
    particlePrefab: {fileID: 0}
  - text: The highest one wins. Simple, isn't it?
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 1
    particlePrefab: {fileID: 0}
  - text: Come now, darling. Show me just how lucky your soul is.
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 5
    particlePrefab: {fileID: 0}
