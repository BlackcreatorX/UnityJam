--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f235e9a96eb7bbb419458f22113d08f2, type: 3}
  m_Name: Lose
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueSequence
  lines:
  - text: HAHAHAHA! Magnificent! Absolutely magnificent!
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 3
    particlePrefab: {fileID: 0}
  - text: Did you really think you could remember every single one of them? How adorable!
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 5
    particlePrefab: {fileID: 0}
  - text: And so, victory belongs to me once again! How fitting! How inevitable!
      How extraordinarily worthy of me!
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 2
    particlePrefab: {fileID: 0}
  - text: "Your soul\u2026\r\nIs mine now."
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 1
    particlePrefab: {fileID: 0}
  - text: Don't worry, darling. I'll make sure to get my money's worth out of this
      acquisition.
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 3
    particlePrefab: {fileID: 0}
  - text: Welcome to your eternity!
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 2
    particlePrefab: {fileID: 0}
