  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f235e9a96eb7bbb419458f22113d08f2, type: 3}
  m_Name: Win
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem.DialogueSequence
  lines:
  - text: YOU'VE GOT TO BE KIDDING ME.
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 7
    particlePrefab: {fileID: 0}
  - text: THAT HORSE HAD LOST 113 TIMES IN A ROW. HOW DO YOU...
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 6
    particlePrefab: {fileID: 0}
  - text: '*GROWL*'
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 7
    particlePrefab: {fileID: 0}
  - text: It seems your little steed has a bit of talent.
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 4
    particlePrefab: {fileID: 0}
  - text: Or perhaps mine was simply distracted. Yes, that must be it.
    speaker: {fileID: 11400000, guid: 6c73fbfa91484ca43a982420233c0fdd, type: 2}
    spriteIndex: 3
    particlePrefab: {fileID: 0}
